{
  "date_now_tolerance": 300,
  "captures": {
    "$date7": {
      "field": "7",
      "format": "%m%d%H%M%S"
    }
  },
  "rules": [
    {
      "name": "acknowledge network sign-on",
      "match": {
        "3": "^9D0000$",
        "$date7_now": "^1$"
      },
      "response": "responses/network-sign-on-approved.json"
    }
  ],
  "default": "responses/network-invalid-transaction.json"
}
